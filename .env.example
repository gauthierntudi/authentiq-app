APP_NAME=Authentiq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL (local / production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=authentiq.db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# uploads = public/uploads (dev) | s3 = Laravel Cloud / AWS
AUTHENTIQ_DOCUMENTS_DISK=uploads
AUTHENTIQ_DOCUMENTS_PREFIX=fileAuthentiq
AUTHENTIQ_QUEUE=default
AUTHENTIQ_OTP_TTL_MINUTES=10

AUTHENTIQ_TEXTRACT_ENABLED=false
AUTHENTIQ_REKOGNITION_ENABLED=false
AUTHENTIQ_REKOGNITION_COLLECTION=authentiq-clients
AUTHENTIQ_REKOGNITION_MIN_SIMILARITY=85

# Microservice PDF Rust (Fly.io) — rasterisation fichiers lourds
AUTHENTIQ_PDF_SERVICE_ENABLED=false
AUTHENTIQ_PDF_SERVICE_URL=https://authentiq-pdf-service.fly.dev
AUTHENTIQ_PDF_SERVICE_API_KEY=
AUTHENTIQ_PDF_SERVICE_TIMEOUT=120
AUTHENTIQ_PDF_SERVICE_MIN_BYTES=2097152
AUTHENTIQ_PDF_SERVICE_DPI=150
AUTHENTIQ_PDF_SERVICE_MAX_PAGES=100

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_SENDER=
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_WHATSAPP_OTP_VARIABLE=1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
AUTHENTIQ_MAIL_FROM=
AUTHENTIQ_MAIL_FROM_NAME=Authentiq

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
